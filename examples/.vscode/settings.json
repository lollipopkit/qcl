{
    // Enable semantic highlighting for QCL
    "editor.semanticHighlighting.enabled": true,
    
    // QCL Language Server settings
    "qcl.lsp.enabled": true,
    "qcl.lsp.autoStart": true,
    "qcl.lsp.semanticTokens.enabled": true,
    "qcl.lsp.semanticTokens.throttleMs": 100,
    
    // Enable verbose logging for debugging (optional)
    // "qcl.lsp.trace": "verbose",
    // "qcl.lsp.outputChannel.enabled": true,
    
    // Ensure QCL files are associated with the right language
    "files.associations": {
        "*.qcl": "qcl"
    },
    
    // Editor settings to enhance semantic highlighting
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": "variable.other.context.qcl",
                "settings": {
                    "foreground": "#ff6b6b",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": "keyword.control.qcl",
                "settings": {
                    "foreground": "#4ecdc4",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": "entity.name.function.qcl",
                "settings": {
                    "foreground": "#45b7d1"
                }
            },
            {
                "scope": "string.quoted.qcl",
                "settings": {
                    "foreground": "#96ceb4"
                }
            },
            {
                "scope": "constant.numeric.qcl",
                "settings": {
                    "foreground": "#ffeaa7"
                }
            },
            {
                "scope": "keyword.operator.qcl",
                "settings": {
                    "foreground": "#fd79a8"
                }
            }
        ]
    },
    
    // Semantic token color customizations
    "editor.semanticTokenColorCustomizations": {
        "rules": {
            "property": {
                "foreground": "#ff6b6b",
                "fontStyle": "bold"
            },
            "variable": {
                "foreground": "#74b9ff"
            },
            "function": {
                "foreground": "#45b7d1"
            },
            "keyword": {
                "foreground": "#4ecdc4",
                "fontStyle": "bold"
            },
            "string": {
                "foreground": "#96ceb4"
            },
            "number": {
                "foreground": "#ffeaa7"
            },
            "operator": {
                "foreground": "#fd79a8"
            },
            "comment": {
                "foreground": "#636e72",
                "fontStyle": "italic"
            }
        }
    }
}