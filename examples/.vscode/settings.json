{
    // Enable semantic highlighting for QCL
    "editor.semanticHighlighting.enabled": true,
    
    // QCL Language Server settings
    "qcl.lsp.enabled": true,
    "qcl.lsp.autoStart": true,
    "qcl.lsp.semanticTokens.enabled": true,
    "qcl.lsp.semanticTokens.throttleMs": 100,
    
    // Enable verbose logging for debugging (optional)
    // "qcl.lsp.trace": "verbose",
    // "qcl.lsp.outputChannel.enabled": true,
}