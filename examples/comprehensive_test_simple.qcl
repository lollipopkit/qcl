// QCL (Query Check Language) 核心功能测试文件
// Core features test file for QCL language

// =============================================================================
// 1. 变量声明和类型注解 / Variable declarations and type annotations
// =============================================================================

// 基本类型 / Basic types
let name: String = "Alice";
let age: Int = 25;
let height: Float = 5.7;
let isActive: Bool = true;
let empty: Nil = nil;

// 集合类型 / Collection types
let numbers: List = [1, 2, 3, 4, 5];
let person: Map = {
    "name": "Bob",
    "age": 30,
    "skills": ["Rust", "JavaScript", "Python"]
};

// 无类型注解的变量 / Variables without type annotations
let score = 95;
let greeting = "Hello, QCL!";

// =============================================================================
// 2. 上下文访问 (@) / Context access (@)
// =============================================================================

// 简单上下文访问 / Simple context access
let user_name = @user.name;
let user_age = @user.age;
let user_role = @request.user.role;

// 嵌套上下文访问 / Nested context access
let street_address = @user.profile.address.street;
let first_skill = @user.skills.0;

// =============================================================================
// 3. 算术运算 / Arithmetic operations
// =============================================================================

let addition = 10 + 5;
let subtraction = 20 - 8;
let multiplication = 6 * 7;
let division = 15 / 3;
let modulo = 17 % 5;

// 语义算术 (3/2 = 1.5) / Semantic arithmetic
let semantic_div = 3 / 2;

// =============================================================================
// 4. 比较运算 / Comparison operations
// =============================================================================

let is_equal = 5 == 5;
let not_equal = 10 != 7;
let less_than = 3 < 8;
let greater_than = 15 > 12;
let less_equal = 4 <= 4;
let greater_equal = 9 >= 6;

// 字符串比较 / String comparison
let str_equal = "hello" == "hello";
let str_not_equal = "world" != "earth";

// =============================================================================
// 5. 逻辑运算 / Logical operations
// =============================================================================

let logical_and = true && false;
let logical_or = true || false;
let logical_not = !false;

// 复杂逻辑表达式 / Complex logical expressions
let complex_logic = (age >= 18) && (age <= 65) && isActive;
let access_check = (@user.role == "manager") || (@user.permissions.read == true);

// =============================================================================
// 6. 列表和Map操作 / List and Map operations
// =============================================================================

let first_number = numbers.0;
let contains_three = 3 in numbers;
let contains_ten = 10 in numbers;

let person_name = person.name;
let person_age = person.age;
let has_name_key = "name" in person;

// =============================================================================
// 7. 控制流 - 条件语句 / Control flow - Conditional statements
// =============================================================================

let access_level = 0;

if (@user.role == "admin") {
    access_level = 100;
} else if (@user.role == "manager") {
    access_level = 50;
} else if (@user.role == "user") {
    access_level = 10;
} else {
    access_level = 0;
}

// =============================================================================
// 8. 控制流 - 循环 / Control flow - Loops
// =============================================================================

let i = 0;
let sum = 0;

// While 循环 / While loop
while (i < 5) {
    if (i == 3) {
        i = i + 1;
        continue;  // 跳过3
    }
    
    sum = sum + i;
    i = i + 1;
}

// =============================================================================
// 9. 函数定义和调用 / Function definitions and calls
// =============================================================================

// 简单函数 / Simple function
fn add(a, b) {
    return a + b;
}

// 无参数函数 / Function without parameters
fn getCurrentTime() {
    return "2024-03-15 10:30:00";
}

// 递归函数 / Recursive function
fn factorial(n) {
    if (n <= 1) {
        return 1;
    } else {
        return n * factorial(n - 1);
    }
}

// 使用上下文的函数 / Function using context
fn getUserFullName() {
    return @user.firstName + " " + @user.lastName;
}

// 复杂业务逻辑函数 / Complex business logic function
fn checkAccess(resource, action) {
    let user_role = @user.role;
    
    if (user_role == "admin") {
        return true;
    }
    
    if (resource == "documents") {
        if (action == "read") {
            return @user.permissions.read == true;
        } else if (action == "write") {
            return @user.permissions.write == true;
        }
    }
    
    return false;
}

// =============================================================================
// 10. 访问控制示例 / Access control examples
// =============================================================================

// 角色基础访问控制 / Role-based access control
fn rbacCheck() {
    let user_role = @request.user.role;
    let required_roles = ["admin", "manager"];
    return user_role in required_roles;
}

// 属性基础访问控制 / Attribute-based access control
fn abacCheck() {
    let user_dept = @request.user.department;
    let resource_dept = @resource.department;
    let action = @request.action;
    let current_hour = 14; // 假设从时间戳解析得到
    
    let same_department = user_dept == resource_dept;
    let business_hours = (current_hour >= 9) && (current_hour <= 17);
    let is_read_action = action == "read";
    
    return same_department && business_hours && is_read_action;
}

// 复杂权限检查 / Complex permission checking
fn complexPermissionCheck() {
    let user = @request.user;
    let resource = @resource;
    let action = @request.action;
    
    // 超级管理员总是有权限 / Super admin always has access
    if (user.role == "superadmin") {
        return true;
    }
    
    // 检查资源所有权 / Check resource ownership
    if (resource.owner == user.id) {
        return true;
    }
    
    // 检查团队权限 / Check team permissions
    if (user.team in resource.allowed_teams) {
        return action in ["read", "write"];
    }
    
    // 检查个人权限 / Check individual permissions
    if (user.id in resource.allowed_users) {
        return action in ["read", "write"];
    }
    
    return false;
}

// 文档访问权限检查 / Document access permission check
fn documentAccessCheck() {
    let user = @request.user;
    let document = @resource.document;
    let action = @request.action;
    
    // 检查文档是否为公开文档 / Check if document is public
    if (document.visibility == "public" && action == "read") {
        return true;
    }
    
    // 检查用户是否为文档作者 / Check if user is document author
    if (document.author_id == user.id) {
        return true;
    }
    
    // 检查部门权限 / Check department permissions
    if (user.department == document.department) {
        return action in ["read", "write"];
    }
    
    return false;
}

// API 限流检查 / API rate limiting check
fn rateLimitCheck() {
    let user = @request.user;
    let current_requests = 45; // 简化的请求计数
    
    // 不同用户等级有不同的限制 / Different limits for different user tiers
    let limit = 0;
    if (user.tier == "premium") {
        limit = 1000;
    } else if (user.tier == "standard") {
        limit = 100;
    } else {
        limit = 10;
    }
    
    return current_requests < limit;
}

// 地理位置访问控制 / Geolocation-based access control
fn geoAccessCheck() {
    let user_country = @request.user.location.country;
    let allowed_countries = @resource.geo_restrictions.allowed_countries;
    let blocked_countries = @resource.geo_restrictions.blocked_countries;
    
    // 检查是否在阻止列表中 / Check if in blocked list
    if (user_country in blocked_countries) {
        return false;
    }
    
    // 如果有允许列表，检查是否在其中 / If allow list exists, check if in it
    if (allowed_countries != nil) {
        return user_country in allowed_countries;
    }
    
    return true;
}

// =============================================================================
// 11. 测试各个功能的执行 / Test execution of all functions
// =============================================================================

// 测试函数调用 / Test function calls
let add_result = add(5, 3);
let factorial_result = factorial(4);
let user_full_name = getUserFullName();

// 测试访问控制 / Test access control
let rbac_result = rbacCheck();
let abac_result = abacCheck();
let complex_permission = complexPermissionCheck();
let document_access = documentAccessCheck();
let rate_limit = rateLimitCheck();
let geo_access = geoAccessCheck();

// =============================================================================
// 12. 最终返回值 / Final return value
// =============================================================================

// 执行一个综合的访问检查 / Execute a comprehensive access check
let final_access_decision = complex_permission && 
                           document_access && 
                           rate_limit && 
                           geo_access;

return final_access_decision;