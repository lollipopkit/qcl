println("=== DateTime Module Demo ===");

// Get current timestamp
let now = datetime.now();

// Format timestamp to readable string
let formatted_date = datetime.format(now, "%Y-%m-%d %H:%M:%S");
let simple_date = datetime.format(now, "%Y-%m-%d");

// Parse datetime string to timestamp
let parsed_time = datetime.parse("2023-12-25 15:30:00", "%Y-%m-%d %H:%M:%S");

// Date arithmetic
let tomorrow = datetime.add(now, 24 * 60 * 60);  // Add 24 hours in seconds
let yesterday = datetime.sub(now, 24 * 60 * 60); // Subtract 24 hours

// Date information
let day_of_week = datetime.day_of_week(now);      // 0-6 (Sun-Sat)
let day_of_year = datetime.day_of_year(now);      // 1-366
let is_weekend = datetime.is_weekend(now);        // true/false

println("Current time: ${formatted_date}");
