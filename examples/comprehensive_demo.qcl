// These would typically be evaluated with actual context data
// Examples show the syntax for access control expressions

// Simple role-based access
let admin_check = "@req.user.role == 'admin'";
let user_check = "@req.user.role in ['user', 'editor']";

// Resource ownership check
let ownership_check = "@req.user.id == @resource.owner_id";

// Time-based access
let time_check = "datetime.now() >= @policy.start_time && datetime.now() <= @policy.end_time";

// Complex policy combining multiple conditions
let complex_policy = "(@req.user.role == 'admin' || @req.user.id in @resource.allowed_users) && @request.method == 'GET'";

println("Policy examples defined (would be evaluated with actual context)");

// =============================================================================
// 19. PERFORMANCE DEMO
// =============================================================================

println("=== Performance and Algorithm Examples ===");

// Example: Fibonacci sequence (recursive vs iterative)
fn fibonacci_recursive(n) {
    if (n <= 1) {
        return n;
    }
    return fibonacci_recursive(n - 1) + fibonacci_recursive(n - 2);
}

fn fibonacci_iterative(n) {
    if (n <= 1) {
        return n;
    }
    
    let a = 0;
    let b = 1;
    let i = 2;
    
    while (i <= n) {
        let temp = a + b;
        a = b;
        b = temp;
        i = i + 1;
    }
    
    return b;
}

let fib_10 = fibonacci_iterative(10);
println("Fibonacci(10) = ${fib_10}");

// Example: Prime number checker
fn is_prime(n) {
    if (n <= 1) {
        return false;
    }
    if (n <= 3) {
        return true;
    }
    if (n % 2 == 0 || n % 3 == 0) {
        return false;
    }
    
    let i = 5;
    while (i * i <= n) {
        if (n % i == 0 || n % (i + 2) == 0) {
            return false;
        }
        i = i + 6;
    }
    
    return true;
}

let prime_check = is_prime(17);
println("Is 17 prime? ${prime_check}");

// =============================================================================
// 20. FINAL DEMO: COMPREHENSIVE INTEGRATION
// =============================================================================

println("=== Final Integration Demo ===");

// A comprehensive example using multiple features
fn process_user_data(users_data) {
    import math;
    import string;
    
    let processed = [];
    let age_sum = 0;
    
    for [index, user] in iter.enumerate(users_data) {
        // Clean and validate data
        let name = string.upper(string.trim(user.name));
        let age = math.max(0, user.age);  // Ensure non-negative
        let email = string.lower(user.email);
        
        age_sum = age_sum + age;
        
        // Process each user
        let processed_user = {
            "id": index + 1,
            "name": name,
            "age": age,
            "email": email,
            "is_adult": age >= 18,
            "age_category": age < 18 ? "minor" : (age < 65 ? "adult" : "senior")
        };
        
        processed.push(processed_user);
    }
    
    let avg_age = age_sum / users_data.len();
    
    return {
        "users": processed,
        "total_users": users_data.len(),
        "average_age": avg_age,
        "processing_date": datetime.format(datetime.now(), "%Y-%m-%d %H:%M:%S")
    };
}

let sample_users = [
    {"name": " alice ", "age": 25, "email": "Alice@Example.com"},
    {"name": "Bob", "age": 17, "email": "BOB@EXAMPLE.COM"},
    {"name": " charlie ", "age": 35, "email": "Charlie@example.com"}
];

let final_result = process_user_data(sample_users);
println("Final processed result: ${final_result}");

