// Comprehensive Stdlib Demo

import math;
import string;
import datetime;
import os;
import tcp;

// --- math ---
fn test_math() {
    // Use a helper to round floats for stable output
    fn round6(x) { return math.round(x * 1000000) / 1000000; }

    return {
        "abs": math.abs(-42),
        "sqrt": math.sqrt(16),
        "sin": round6(math.sin(1.0)),
        "cos": round6(math.cos(1.0)),
        "tan": round6(math.tan(1.0)),
        "asin": round6(math.asin(0.5)),
        "acos": round6(math.acos(0.5)),
        "atan": round6(math.atan(1.0)),
        "atan2": round6(math.atan2(1.0, 1.0)),
        "log": round6(math.log(2.718281828)),
        "log10": round6(math.log10(100.0)),
        "log2": round6(math.log2(8.0)),
        "exp": round6(math.exp(1.0)),
        "pow": math.pow(2.0, 8.0),
        "floor": math.floor(3.7),
        "ceil": math.ceil(3.2),
        "round": math.round(2.5),
        "min": math.min(3, 7),
        "max": math.max(3, 7),
        "pi": round6(math.pi),
        "e": round6(math.e)
    };
}

// --- string ---
fn test_string() {
    let parts = string.split("a,b,c", ",");
    let joined = string.join(parts, "-");

    return {
        "len": string.len("  Hello  "),
        "lower": string.lower("HeLLo"),
        "upper": string.upper("HeLLo"),
        "trim": string.trim("  spaced  "),
        "starts_with": string.starts_with("hello", "he"),
        "ends_with": string.ends_with("hello", "lo"),
        "contains": string.contains("banana", "na"),
        "replace": string.replace("a-b-a", "-", "+"),
        "substring": string.substring("abcdef", 1, 3),
        "split": string.split("x|y|z", "|"),
        "join": joined
    };
}

// --- datetime ---
fn test_datetime() {
    // Fixed timestamp for deterministic checks
    let ts = datetime.parse("2023-01-01 00:00:00", "%Y-%m-%d %H:%M:%S");
    let ts_fmt = datetime.format(ts, "%Y-%m-%d");
    let added = datetime.add(ts, 3600); // +1 hour
    let subbed = datetime.sub(ts, 86400); // -1 day
    return {
        "now": datetime.now(), // Non-deterministic; provided for completeness
        "parse": ts,
        "format": ts_fmt,
        "add": added,
        "sub": subbed,
        "day_of_week": datetime.day_of_week(ts),
        "day_of_year": datetime.day_of_year(ts),
        "is_weekend": datetime.is_weekend(ts)
    };
}

// --- os ---
fn test_os() {
    // Environment variable roundtrip (safe temporary var)
    let _ = os.env.set("QCL_DEMO_TMP", "123");
    let got = os.env.get("QCL_DEMO_TMP");
    let _2 = os.env.unset("QCL_DEMO_TMP");

    // Directory helpers (relative paths only)
    let cwd = os.dir.current();
    let tmp = os.dir.temp();
    // List small, safe directory: current directory
    let listing = os.dir.list(".");

    return {
        "hostname": os.hostname(),
        "arch": os.arch(),
        "os": os.os(),
        "env_roundtrip": got,
        "dir_current": cwd,
        "dir_temp": tmp,
        "dir_list_count": string.len(string.join(listing, ",")) > 0
    };
}

// --- tcp ---
fn test_tcp() {
    // Safe DNS resolution (no outbound connections)
    let ip = tcp.resolve("localhost");

    // Bind/close on ephemeral port to validate server-side helpers
    let listener_id = tcp.bind("127.0.0.1:0");
    let closed = tcp.close_listener(listener_id);

    return {
        "resolve_localhost": ip,
        "bind_close_ok": closed
    };
}

// Aggregate and return results from all stdlib modules
return {
    "math": test_math(),
    "string": test_string(),
    "datetime": test_datetime(),
    "os": test_os(),
    "tcp": test_tcp()
};
