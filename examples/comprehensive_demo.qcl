// 16. COMPLEX EXAMPLES AND REAL-WORLD SCENARIOS
// =============================================================================

println("=== Real-World Example: Data Processing ===");

// Example: Calculate statistics from a dataset
let dataset = [23, 45, 67, 89, 12, 34, 56, 78, 90, 1];

fn calculate_stats(data) {
    if (data.len() == 0) {
        return {"count": 0, "sum": 0, "avg": 0, "min": 0, "max": 0};
    }
    
    let sum = 0;
    let min = data[0];
    let max = data[0];
    
    for value in data {
        sum = sum + value;
        if (value < min) { min = value; }
        if (value > max) { max = value; }
    }
    
    let avg = sum / data.len();
    
    return {
        "count": data.len(),
        "sum": sum,
        "avg": avg,
        "min": min,
        "max": max
    };
}

let stats = calculate_stats(dataset);
println("Statistics: ${stats}");

println("=== Real-World Example: Text Processing ===");

// Example: Word frequency counter
fn count_words(text) {
    let words = string.lower(string.trim(text));
    let word_list = string.split(words, " ");
    let frequency = {};
    
    for word in word_list {
        if (string.len(word) > 0) {
            if (frequency[word] ?? nil) {
                frequency[word] = frequency[word] + 1;
            } else {
                frequency[word] = 1;
            }
        }
    }
    
    return frequency;
}

let sample_text = "hello world hello qcl world hello";
let word_counts = count_words(sample_text);
println("Word counts: ${word_counts}");

println("=== Real-World Example: Date Validation ===");

// Example: Business day calculator
fn is_business_day(timestamp) {
    let day = datetime.day_of_week(timestamp);
    // 0 = Sunday, 6 = Saturday
    return day != 0 && day != 6;
}

fn add_business_days(start_timestamp, days) {
    let current = start_timestamp;
    let remaining = days;
    
    while (remaining > 0) {
        current = datetime.add(current, 24 * 60 * 60); // Add one day
        if (is_business_day(current)) {
            remaining = remaining - 1;
        }
    }
    
    return current;
}

let business_date = add_business_days(now, 5);
println("5 business days from now: ${datetime.format(business_date, "%Y-%m-%d")}");

