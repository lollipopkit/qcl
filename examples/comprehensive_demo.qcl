// =============================================================================
// QCL (Query Check Language) - Comprehensive Demo
// =============================================================================
// This file demonstrates all available QCL syntax features and standard library
// functions. QCL combines expression evaluation for ACL/policy checking with
// full programming language capabilities.
// =============================================================================

// =============================================================================
// 1. BASIC EXPRESSIONS AND OPERATORS
// =============================================================================

// Literals and basic types
let int_val = 42;
let float_val = 3.14159;
let str_val = "Hello QCL!";
let bool_val = true;
let nil_val = nil;

// Arithmetic operators
let sum = 10 + 20;              // Addition
let difference = 50 - 15;       // Subtraction
let product = 6 * 7;            // Multiplication
let quotient = 100 / 3;         // Division (with semantic arithmetic)
let remainder = 17 % 5;         // Modulo

// Comparison operators
let eq_check = 10 == 10;        // Equal
let ne_check = 10 != 5;         // Not equal
let lt_check = 5 < 10;          // Less than
let gt_check = 10 > 5;          // Greater than
let le_check = 5 <= 5;          // Less than or equal
let ge_check = 10 >= 10;        // Greater than or equal

// Logical operators
let logical_and = true && false; // Logical AND
let logical_or = true || false;  // Logical OR
let logical_not = !true;         // Logical NOT

// Advanced operators
let nullish_coalesce = nil ?? "default";  // Nullish coalescing
let optional_chain = {"name": "Alice"}?.name;  // Optional chaining

// =============================================================================
// 2. DATA STRUCTURES
// =============================================================================

// Lists (arrays)
let numbers = [1, 2, 3, 4, 5];
let mixed_list = ["text", 42, true, {"key": "value"}];
let nested_list = [[1, 2], [3, 4], [5, 6]];

// Maps (objects/dictionaries)
let person = {
    "name": "Alice",
    "age": 30,
    "city": "New York",
    "skills": ["Rust", "Python", "JavaScript"]
};

// Accessing data structures
let first_num = numbers[0];                    // List index access
let person_name = person["name"];             // Map key access
let person_age = person.age;                  // Dot notation access
let first_skill = person.skills[0];           // Nested access

// Template strings with interpolation
let greeting = "Hello, ${person.name}!";
let formatted = "The sum of ${a} and ${b} is ${a + b}";

// =============================================================================
// 3. CONTROL FLOW
// =============================================================================

// If-else statements
let x = 10;
if (x > 0) {
    println("x is positive");
} else if (x < 0) {
    println("x is negative");
} else {
    println("x is zero");
}

// While loops
let counter = 0;
while (counter < 5) {
    println("Counter: ${counter}");
    counter = counter + 1;
}

// For loops with different patterns
// Simple iteration
for item in [1, 2, 3] {
    println("Item: ${item}");
}

// Ignore pattern (like _ in Rust)
for _ in 0..3 {
    println("Hello!");
}

// Tuple destructuring for map iteration
for (key, value) in {"a": 1, "b": 2} {
    println("Key: ${key}, Value: ${value}");
}

// Array destructuring with rest patterns
for [first, ..rest] in [[1, 2, 3], [4, 5, 6]] {
    println("First: ${first}, Rest: ${rest}");
}

// Range expressions
for i in 0..5 {           // Exclusive range (0, 1, 2, 3, 4)
    println("Range i: ${i}");
}

for j in 1..=3 {          // Inclusive range (1, 2, 3)
    println("Range j: ${j}");
}

// Break and continue
for i in 0..10 {
    if (i == 3) {
        continue;  // Skip 3
    }
    if (i == 7) {
        break;      // Stop at 7
    }
    println("i: ${i}");
}

// =============================================================================
// 4. FUNCTIONS AND CLOSURES
// =============================================================================

// Function definition
fn add(a, b) {
    return a + b;
}

// Function without explicit return (last expression is returned)
fn multiply(x, y) {
    x * y
}

// Function with type annotation
fn calculate_area(width: Int, height: Int) -> Int {
    width * height
}

// Higher-order function
fn apply_twice(f, x) {
    f(f(x))
}

// Closure (anonymous function)
let square = |x| x * x;
let increment = |x| x + 1;

// Using closures
let doubled = apply_twice(|x| x * 2, 5);  // (5 * 2) * 2 = 20
let squared = apply_twice(square, 3);      // (3^2)^2 = 81

// Functions as return values
fn make_multiplier(n) {
    return |x| x * n;
}

let times3 = make_multiplier(3);
let result = times3(7);  // 21

// =============================================================================
// 5. IMPORT SYSTEM
// =============================================================================

// Different import syntaxes
import math;                           // Import entire module
import string;                         // Import string module
import datetime;                       // Import datetime module
import os;                             // Import OS module
import io;                             // Import I/O module
import iter;                           // Import iterator utilities

// Import specific functions (destructuring import)
import { abs, sqrt, sin, cos } from math;

// Import with alias
import math as m;
let pi_value = m.pi;

// Namespace import
import * as datetime from datetime;
let current_time = datetime.now();

// Import from file path (would load from actual file)
// import "path/to/custom_module.qcl";

// =============================================================================
// 6. STANDARD LIBRARY - MATH MODULE
// =============================================================================

println("=== Math Module Demo ===");

// Basic math functions
let abs_val = math.abs(-42);           // 42
let sqrt_val = math.sqrt(16);          // 4.0
let sin_val = math.sin(math.pi / 2);   // ~1.0
let cos_val = math.cos(0);             // 1.0
let tan_val = math.tan(math.pi / 4);   // ~1.0

// Advanced math functions
let log_val = math.log(100);           // Natural log
let log10_val = math.log10(100);       // Base-10 log
let log2_val = math.log2(8);           // Base-2 log
let exp_val = math.exp(1);             // e^1
let pow_val = math.pow(2, 10);         // 2^10 = 1024

// Rounding functions
let floor_val = math.floor(3.7);       // 3
let ceil_val = math.ceil(3.2);         // 4
let round_val = math.round(3.5);       // 4

// Min/max functions
let min_val = math.min(10, 20);        // 10
let max_val = math.max(10, 20);        // 20

// Constants
let pi_constant = math.pi;             // �
let e_constant = math.e;               // e

println("Math functions demo completed");

// =============================================================================
// 7. STANDARD LIBRARY - STRING MODULE
// =============================================================================

println("=== String Module Demo ===");

let sample_text = "Hello, QCL World!";

// String manipulation
let len_str = string.len(sample_text);           // Length
let lower_str = string.lower(sample_text);       // Lowercase
let upper_str = string.upper(sample_text);       // Uppercase
let trimmed_str = string.trim("  spaces  ");      // Trim whitespace

// String checking
let starts_hello = string.starts_with(sample_text, "Hello");
let ends_world = string.ends_with(sample_text, "World!");
let contains_qcl = string.contains(sample_text, "QCL");

// String operations
let replaced_str = string.replace(sample_text, "World", "Universe");
let substring_str = string.substring(sample_text, 7, 3);  // "QCL"

// String splitting and joining
let csv_data = "apple,banana,cherry";
let fruits = string.split(csv_data, ",");               // ["apple", "banana", "cherry"]
let joined_str = string.join(fruits, " & ");            // "apple & banana & cherry"

println("String functions demo completed");

// =============================================================================
// 8. STANDARD LIBRARY - ITERATOR MODULE
// =============================================================================

println("=== Iterator Module Demo ===");

// Enumerate function (adds index to items)
let indexed_fruits = iter.enumerate(fruits);     // [[0, "apple"], [1, "banana"], [2, "cherry"]]

// Range function variations
let range_5 = iter.range(5);                      // [0, 1, 2, 3, 4]
let range_2_5 = iter.range(2, 5);                 // [2, 3, 4]
let range_step = iter.range(0, 10, 2);            // [0, 2, 4, 6, 8]

// Working with enumerated items
for [index, fruit] in indexed_fruits {
    println("Index ${index}: ${fruit}");
}

println("Iterator functions demo completed");

