{
  "name": "vscode-qcl",
  "displayName": "QCL Language Support",
  "description": "Language support for QCL (Query Check Language) with LSP integration",
  "version": "0.0.1",
  "publisher": "lollipopkit",
  "author": {
    "name": "lollipopkit",
    "email": "a@lpkt.cn",
    "url": "https://github.com/lollipopkit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lollipopkit/qcl.git"
  },
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:qcl",
    "onCommand:qcl.restartServer",
    "onCommand:qcl.startServer",
    "onCommand:qcl.showStatusBarMenu",
    "onCommand:qcl.analyzeCurrentFile"
  ],
  "contributes": {
    "commands": [
      {
        "command": "qcl.startServer",
        "title": "QCL: Start Language Server",
        "category": "QCL"
      },
      {
        "command": "qcl.restartServer",
        "title": "QCL: Restart Language Server",
        "category": "QCL"
      },
      {
        "command": "qcl.showStatusBarMenu",
        "title": "QCL: Show Status Bar Menu",
        "category": "QCL"
      },
      {
        "command": "qcl.analyzeCurrentFile",
        "title": "QCL: Analyze Current File",
        "category": "QCL"
      }
    ],
    "languages": [
      {
        "id": "qcl",
        "aliases": [
          "QCL",
          "qcl"
        ],
        "extensions": [
          ".qcl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "qcl",
        "scopeName": "source.qcl",
        "path": "./syntaxes/qcl.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "comment",
        "description": "Comments",
        "superType": "comment"
      },
      {
        "id": "keyword",
        "description": "Keywords",
        "superType": "keyword"
      },
      {
        "id": "variable",
        "description": "Variables",
        "superType": "variable"
      },
      {
        "id": "function",
        "description": "Functions",
        "superType": "function"
      },
      {
        "id": "string",
        "description": "Strings",
        "superType": "string"
      },
      {
        "id": "number",
        "description": "Numbers",
        "superType": "number"
      },
      {
        "id": "operator",
        "description": "Operators",
        "superType": "operator"
      },
      {
        "id": "parameter",
        "description": "Parameters",
        "superType": "parameter"
      },
      {
        "id": "property",
        "description": "Properties",
        "superType": "property"
      },
      {
        "id": "namespace",
        "description": "Namespaces",
        "superType": "namespace"
      },
      {
        "id": "type",
        "description": "Types",
        "superType": "type"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "declaration",
        "description": "Declaration"
      },
      {
        "id": "definition",
        "description": "Definition"
      },
      {
        "id": "readonly",
        "description": "Readonly"
      },
      {
        "id": "static",
        "description": "Static"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "qcl",
        "scopes": {
          "comment": [
            "comment",
            "comment.line",
            "comment.block",
            "punctuation.definition.comment.qcl",
            "punctuation.definition.comment.begin.qcl",
            "punctuation.definition.comment.end.qcl"
          ],
          "keyword": [
            "keyword.control.qcl",
            "keyword.other.qcl"
          ],
          "variable": [
            "variable.other.qcl"
          ],
          "function": [
            "entity.name.function.qcl",
            "support.function.qcl"
          ],
          "string": [
            "string.quoted.qcl"
          ],
          "number": [
            "constant.numeric.qcl"
          ],
          "operator": [
            "keyword.operator.qcl"
          ],
          "parameter": [
            "variable.parameter.qcl"
          ],
          "property": [
            "variable.other.property.qcl",
            "support.variable.property.qcl"
          ],
          "namespace": [
            "entity.name.namespace.qcl"
          ],
          "type": [
            "support.type.qcl",
            "entity.name.type.qcl"
          ]
        }
      }
    ],
    "configuration": {
      "type": "object",
      "title": "QCL Configuration",
      "properties": {
        "qcl.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable QCL Language Server Protocol integration"
        },
        "qcl.lsp.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start the QCL language server on activation"
        },
        "qcl.lsp.serverPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to the QCL LSP server binary (leave empty to use PATH or auto-detection). Supports '~' for home directory."
        },
        "qcl.lsp.trace": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Trace communication between VSCode and the QCL language server"
        },
        "qcl.lsp.outputChannel.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Show a dedicated output channel for QCL (may affect performance)"
        },
        "qcl.lsp.semanticTokens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable semantic tokens; disable to rely on TextMate highlighting only"
        },
        "qcl.lsp.semanticTokens.throttleMs": {
          "type": "number",
          "default": 25,
          "minimum": 0,
          "description": "Throttle consecutive semantic token requests per document (ms). Set 0 to disable."
        },
        "qcl.lsp.inlayHints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inlay hints (inline editor hints) from QCL LSP"
        },
        "qcl.lsp.inlayHints.throttleMs": {
          "type": "number",
          "default": 25,
          "minimum": 0,
          "description": "Throttle consecutive inlay hint requests per document (ms). Set 0 to disable."
        },
        "qcl.lsp.inlayHints.parameters.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show parameter name hints at call sites"
        },
        "qcl.lsp.inlayHints.types.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inferred type hints for declarations (let/define)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "package:preview": "vsce package --pre-release",
    "publish": "vsce publish",
    "publish:preview": "vsce publish --pre-release"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "@types/vscode": "^1.103.0",
    "typescript": "^5.9.2",
    "vsce": "^2.15.0",
    "vscode-languageclient": "^9.0.1"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
