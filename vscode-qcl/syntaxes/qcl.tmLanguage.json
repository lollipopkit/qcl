{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "QCL",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#context-access" },
    { "include": "#functions" }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.qcl",
          "match": "\\b(if|else|while|let|return|fn|go|select|case|default|break|continue|import|from|as|in)\\b"
        },
        {
          "name": "storage.type.qcl",
          "match": "\\b(true|false|nil)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.qcl",
          "match": "(\\|\\||&&)"
        },
        {
          "name": "keyword.operator.comparison.qcl",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.qcl",
          "match": "(\\+|-|\\*|\\/|%)"
        },
        {
          "name": "keyword.operator.assignment.qcl",
          "match": "="
        },
        {
          "name": "keyword.operator.unary.qcl",
          "match": "!"
        },
        {
          "name": "keyword.operator.channel.qcl",
          "match": "<-"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.qcl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.qcl",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.qcl",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.qcl",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.qcl",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.qcl",
          "begin": "#",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.qcl" }
          },
          "end": "$"
        },
        {
          "name": "comment.line.double-slash.qcl",
          "begin": "//",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.qcl" }
          },
          "end": "$"
        },
        {
          "name": "comment.block.qcl",
          "begin": "/\\*",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.qcl" }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.qcl" }
          }
        }
      ]
    },
    "context-access": {
      "patterns": [
        {
          "name": "variable.other.context.qcl",
          "match": "@[a-zA-Z_][a-zA-Z0-9_.]*"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.qcl",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\s*(?=\\()"
        }
      ]
    }
  },
  "scopeName": "source.qcl"
}
