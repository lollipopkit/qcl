// 测试完整的 Go 风格 channel 和 select 语法实现
import tcp;

// 创建无缓冲 channel
let ch1 = make_chan();
let ch2 = make_chan();

// 启动 goroutine 发送数据
go {
    ch1 <- "hello";
    ch2 <- 42;
}

// 测试 select 语句的各种语法
select {
case msg = <-ch1: {
    // 接收字符串消息并赋值给 msg 变量
    print("Received string:", msg);
}
case num = <-ch2: {
    // 接收数字并赋值给 num 变量  
    print("Received number:", num);
}
case <-timeout_chan: {
    // 超时处理（只接收，不保存值）
    print("Timeout occurred");
}
default: {
    // 默认分支
    print("No channels ready");
}
}

// 测试 channel 发送语法
go {
    let result_ch = make_chan();
    
    select {
    case result_ch <- "done": {
        print("Successfully sent result");
    }
    case err = <-error_ch: {
        print("Got error:", err);
    }
    }
}

// 测试多个 select 操作
let data_ch = make_chan(10); // 有缓冲 channel

// 发送方
go {
    data_ch <- 1;
    data_ch <- 2;
    data_ch <- 3;
}

// 接收方
go {
    while (true) {
        select {
        case value = <-data_ch: {
            print("Processing value:", value);
            if (value == 3) {
                break;
            }
        }
        default: {
            print("No data available, waiting...");
            // 这里可以做其他工作
        }
        }
    }
}